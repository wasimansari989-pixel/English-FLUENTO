# Backend Server Configuration
PORT=3001

# AI Provider Selection: 'gemini' | 'groq' | 'mock'
AI_PROVIDER=gemini

# Google Gemini API Settings (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Settings (Free tier available at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Rate Limiting & Quotas
DAILY_QUESTION_LIMIT_PER_USER=50
MAX_USER_INPUT_LENGTH=1000
REQUEST_TIMEOUT_MS=15000
