{
  "expo": {
    "name": "English Formula 600",
    "slug": "english-formula-600",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "englishformula",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E5E5EB",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#E5E5EB"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#E5E5EB"
    },
    "newArchEnabled": true,
    "android": {
      "package": "com.englishformula.app",
      "backgroundColor": "#E5E5EB",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E5E5EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5E5EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow English Formula 600 to access your microphone for real-time voice English practice."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D4FF00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
